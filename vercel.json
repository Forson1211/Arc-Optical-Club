{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci --include=optional",
  "buildCommand": "npm run build --workspace backend && npm run build --workspace frontend",
  "outputDirectory": "frontend/dist",
  "env": { "NODEJS_HELPERS": "0" },
  "functions": {
    "api/index.mjs": { "includeFiles": "backend/dist/**", "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/news", "destination": "/api?arc_seo=/news" },
    { "source": "/news/:id", "destination": "/api?arc_seo=/news/:id" },
    { "source": "/admin/:path*", "destination": "/admin.html" },
    { "source": "/about", "destination": "/about/index.html" },
    { "source": "/programs", "destination": "/programs/index.html" },
    { "source": "/team", "destination": "/team/index.html" },
    { "source": "/partners", "destination": "/partners/index.html" },
    { "source": "/academy", "destination": "/academy/index.html" },
    { "source": "/research", "destination": "/research/index.html" },
    { "source": "/gallery", "destination": "/gallery/index.html" },
    { "source": "/donate", "destination": "/donate/index.html" },
    { "source": "/donate/thank-you", "destination": "/donate/thank-you/index.html" },
    { "source": "/join", "destination": "/join/index.html" },
    { "source": "/contact", "destination": "/contact/index.html" }
  ],
  "headers": [
    { "source": "/admin/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] },
    { "source": "/donate/thank-you", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] },
    {
      "source": "/optimized/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
