PORT=5001
NODE_ENV=development
# Leave empty to use persistent local development storage in backend/.data/.
# Required in production, e.g. mongodb://127.0.0.1:27017/arc_optical_club
MONGODB_URI=
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173
# Use "none" only when frontend and API are hosted on different sites, over HTTPS.
COOKIE_SAME_SITE=lax
# Set to 1 only when the API is behind one trusted reverse proxy.
TRUST_PROXY=0
# Optional first administrator bootstrap. Otherwise run npm run setup:admin.
# Use a private email and a strong password of at least 12 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Server-only Paystack secret key. Start with a test key; never add this to frontend variables.
PAYSTACK_SECRET_KEY=
# Optional whsec_ signing secret from Paystack. When configured, the timestamped
# Paystack-Signature header is required; otherwise X-Paystack-Signature is verified.
PAYSTACK_WEBHOOK_SECRET=
# Configure https://YOUR_API_HOST/api/donations/webhook in the Paystack dashboard.
# Checkout returns to the allowed frontend origin at /donate/thank-you.
